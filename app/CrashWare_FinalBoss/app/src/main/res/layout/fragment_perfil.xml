<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="?attr/colorPrimarySurface"
            android:elevation="10dp"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Nome do App -->
            <TextView
                android:id="@+id/txtNomePerfil"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/righteous"
                android:text=""
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Membro desde... -->
            <TextView
                android:id="@+id/txtMembroDesde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:fontFamily="@font/inter_bold"
                android:text=""
                android:textStyle="bold"
                android:textColor="#828282"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/txtNomePerfil"
                app:layout_constraintTop_toBottomOf="@id/txtNomePerfil" />

            <!-- Configurações -->
            <ImageView
                android:id="@+id/imgConfigPerfil"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="logo"
                android:src="@drawable/config_icon"
                app:layout_constraintEnd_toEndOf="@id/header"
                app:layout_constraintTop_toTopOf="@id/header"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Banner -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgBanner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:shapeAppearanceOverlay="@style/Banner"
            app:strokeColor="#111827"
            app:strokeWidth="2dp" />

        <!-- Alterar Banner -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alterarBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:padding="3dp"
            android:background="@drawable/bg_voltar"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Adicionar Anotacao -->
            <ImageView
                android:id="@+id/imgLapisBanner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/lapis_icon"
                app:layout_constraintStart_toStartOf="@id/alterarBanner"
                app:layout_constraintTop_toTopOf="@id/alterarBanner" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--Imagem de Perfil -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFotoPerfil"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="95dp"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:src="@drawable/faustao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="?attr/colorOnSurface"
            app:strokeWidth="2dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alterarFotoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="5dp"
            android:padding="3dp"
            android:background="@drawable/bg_voltar"
            app:layout_constraintTop_toTopOf="@id/imgFotoPerfil"
            app:layout_constraintEnd_toEndOf="@id/imgFotoPerfil">

            <!-- Adicionar Anotacao -->
            <ImageView
                android:id="@+id/imgLapisFotoPerfil"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/lapis_icon"
                app:layout_constraintStart_toStartOf="@id/alterarFotoPerfil"
                app:layout_constraintTop_toTopOf="@id/alterarFotoPerfil" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Nível do Usuário -->
        <TextView
            android:id="@+id/txtNivelPerfil"
            android:layout_width="0dp"
            android:layout_marginTop="5dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/righteous"
            android:text="NÍVEL"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/barraProgressoPerfil"
            app:layout_constraintTop_toBottomOf="@id/imgFotoPerfil" />

        <!-- Barra de Progresso -->
        <ProgressBar
            android:id="@+id/barraProgressoPerfil"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:max="500"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bg_barraprogresso"
            app:layout_constraintEnd_toEndOf="@id/cardPatentePerfil"
            app:layout_constraintStart_toStartOf="@id/cardPatentePerfil"
            app:layout_constraintTop_toBottomOf="@id/txtNivelPerfil" />

        <!--XP do usuário -->
        <TextView
            android:id="@+id/txtXPPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/righteous"
            android:text="xp"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/barraProgressoPerfil"
            app:layout_constraintTop_toTopOf="@id/txtNivelPerfil" />

        <!-- Card XP -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardXP"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:background="@drawable/bg_cards"
            app:layout_constraintTop_toBottomOf="@id/barraProgressoPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Imagem XP -->
            <ImageView
                android:id="@+id/imgXP"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/diamante_icon"
                app:layout_constraintStart_toStartOf="@id/cardXP"
                app:layout_constraintTop_toTopOf="@id/cardXP"
                app:layout_constraintBottom_toBottomOf="@id/cardXP" />

            <!-- Quantidade de XP -->
            <TextView
                android:id="@+id/txtTotalXP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/righteous"
                android:text="GEMAS"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/imgXP"
                app:layout_constraintTop_toTopOf="@id/cardXP" />

            <!-- Total de XP -->
            <TextView
                android:id="@+id/txtQuantGemas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/righteous"
                android:text=""
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="@+id/cardXP"
                app:layout_constraintTop_toTopOf="@id/cardXP" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card Patente -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardPatentePerfil"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:background="@drawable/bg_cards"
            app:layout_constraintTop_toBottomOf="@id/cardXP"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Imagem Patente -->
            <ImageView
                android:id="@+id/imgPatente"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:src="@drawable/patente_icon"
                app:tint="#9E260A"
                app:layout_constraintStart_toStartOf="@id/cardPatentePerfil"
                app:layout_constraintTop_toTopOf="@id/cardPatentePerfil"
                app:layout_constraintBottom_toBottomOf="@id/cardPatentePerfil" />

            <!-- Divisão da Patente -->
            <TextView
                android:id="@+id/txtDivisao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/righteous"
                android:text="Patente"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/imgPatente"
                app:layout_constraintTop_toTopOf="@id/cardPatentePerfil" />

            <!-- Pantente -->
            <TextView
                android:id="@+id/txtPatente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/righteous"
                android:text=""
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="@+id/cardPatentePerfil"
                app:layout_constraintTop_toTopOf="@id/cardPatentePerfil" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card Conquistas -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardConquistas"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            android:background="@drawable/bg_cards"
            app:layout_constraintTop_toBottomOf="@id/cardPatentePerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Titulo Conquistas -->
            <TextView
                android:id="@+id/txtConquistas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/righteous"
                android:text="Conquistas"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Lista das Conquistas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConquistas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@id/txtConquistas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Texto Ver todas as conquistas -->
            <TextView
                android:id="@+id/txtVerTodasConquistas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/righteous"
                android:text="ver todas as conquistas"
                android:textAllCaps="true"
                android:textColor="@color/verde"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvConquistas" />

            <!-- Barra -->
            <View
                android:layout_width="165dp"
                android:layout_height="2dp"
                android:background="@color/verde"
                app:layout_constraintTop_toBottomOf="@id/txtVerTodasConquistas"
                app:layout_constraintStart_toStartOf="@id/txtVerTodasConquistas"
                app:layout_constraintEnd_toEndOf="@id/txtVerTodasConquistas"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Nosso espaçamento padrão -->
        <View
            android:id="@+id/espaco_nav_bar"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardConquistas" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
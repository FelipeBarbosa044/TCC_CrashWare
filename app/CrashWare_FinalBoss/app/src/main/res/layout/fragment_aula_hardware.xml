<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="?attr/colorPrimarySurface"
        android:elevation="10dp"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/addAnotacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:padding="5dp"
            android:background="@drawable/bg_voltar"
            app:layout_constraintTop_toTopOf="@id/header"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Adicionar Anotacao -->
            <ImageView
                android:id="@+id/imgVoltarCampos"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/seta_icon"
                app:layout_constraintStart_toStartOf="@id/addAnotacao"
                app:layout_constraintTop_toTopOf="@id/addAnotacao" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/txtVoltar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/righteous"
            android:text="Voltar às aulas"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@id/addAnotacao"
            app:layout_constraintTop_toTopOf="@id/addAnotacao" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">

            <!-- Imagem Livro -->
            <ImageView
                android:id="@+id/imgVideo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/aulaassistir_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/conteudo" />

            <TextView
                android:id="@+id/txtTituloAula"
                android:layout_width="284dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/battambang_bold"
                android:lineSpacingExtra="-10sp"
                android:text="Introdução Hardware"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                app:layout_constraintStart_toEndOf="@id/imgVideo"
                app:layout_constraintTop_toTopOf="@id/imgVideo" />

            <TextView
                android:id="@+id/txtTempoAula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"

                android:fontFamily="@font/battambang"
                android:lineSpacingExtra="-10sp"
                android:text="22 minutos"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/imgVideo"
                app:layout_constraintTop_toBottomOf="@id/txtTituloAula" />

            <TextView
                android:id="@+id/txtQuantXPAula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="-0dp"
                android:fontFamily="@font/battambang"
                android:lineSpacingExtra="-10sp"
                android:text="+1000 XP ao concluir"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@id/txtTituloAula"
                app:layout_constraintTop_toBottomOf="@id/txtTituloAula" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardVideo"
                android:layout_width="match_parent"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="40dp"
                android:layout_marginStart="40dp"
                android:layout_height="220dp"
                app:cardCornerRadius="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTempoAula">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="true"
                    app:resize_mode="fit"/>
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardArtigo"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingBottom="20dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:background="@drawable/bg_cards"
                app:layout_constraintTop_toBottomOf="@id/cardVideo"
                app:layout_constraintStart_toStartOf="@id/imgVideo"
                app:layout_constraintEnd_toEndOf="@id/txtQuantXPAula">

                <TextView
                    android:id="@+id/txtIntroducao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="1. Por que aprender tecnologia importa?"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toTopOf="@id/cardArtigo" />

                <TextView
                    android:id="@+id/txtDescrIntroducao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Primeiro é necessário entender a importância  da tecnologia e o que ela representa para nós seres humanos e seu apoio na sociedade, a origem da palavra tecnologia vem do grego onde techne representa a arte, técnica ou ofício e logos significa estudo ou conjunto de saberes.
A tecnologia sempre traz como proposta suprir as necessidades humanas, aumentar a produtividade e expandir o potencial de realização de tarefas, sempre se aprimorando para ser o conjunto de ferramentas e técnicas mais atual como método eficiente para resolução e otimização de problemas
O aprendizado contínuo é o motor do desenvolvimento pessoal e profissional, especialmente no setor de tecnologia, que se transformam a cada dia. Hoje, o mercado não exige apenas o domínio técnico de códigos ou componentes, mas também uma alta capacidade de adaptação.
Nesse cenário, para quem está dando os primeiros passos rumo ao desconhecido, a motivação e a mentalidade de crescimento são os pilares para o sucesso. A motivação alimenta a persistência diante de conceitos que parecem complexos à primeira vista, principalmente quando o estudante entende e percebe a aplicação prática do que está aprendendo. Já a mentalidade de crescimento transforma a curiosidade e a disciplina em hábitos diários, preparando o futuro profissional desde a sua primeira linha de código ou conceitos de hardware.
"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtIntroducao" />

                <TextView
                    android:id="@+id/txtConteudo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="2. Desafios"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtDescrIntroducao" />

                <TextView
                    android:id="@+id/txtDescrConteudo"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text=" • Abordagens ultrapassadas: O ensino tradicional foca em métodos excessivamente teóricos, densos e engessados. Ignora-se que quem nunca teve contato com a área e precisa de uma transição suave e receptiva, respeitando o ritmo de aprendizado individual.
                                                         • Complexidade técnica e falta de didática: Grande parte do conteúdo disponível sobre desenvolvimento de software e infraestrutura de hardware carece de estrutura e objetividade. A presença de jargões técnicos excessivos logo no início assusta e afasta potenciais novos talentos.
                                                       • O estigma da área: Existe uma percepção cultural de que trabalhar com tecnologia é apenas para mentes matemáticas ou prodígios, o que cria uma exclusão psicológica e social, desencorajando pessoas interessadas que acreditam não ter o perfil para a área."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtDescrConteudoCont" />

                <TextView
                    android:id="@+id/txtDescrConteudoCont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Apesar da alta demanda e das oportunidades na área de tecnologia, o caminho para os estudantes iniciantes apresenta barreiras significativas por diversos motivos, o que costumam intimidar quem não tem nenhum conhecimento prévio. As principais são:"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtConteudo" />

                <TextView
                    android:id="@+id/txtEvolProfissional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="3. A ponte para o conhecimento"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtDescrConteudo" />

                <TextView
                    android:id="@+id/txtDescrEvolProfissional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="•	Aprendizado acessível: Plataformas digitais interativas rompem barreiras, permitindo que conceitos complexos de hardware e software sejam fragmentados em lições curtas e diárias dividindo e simplificando alguns conteúdos densos. O conteúdo se ajusta ao desempenho do usuário, garantindo uma introdução sem sobrecarga cognitiva.


                                       •	Cativação: Recursos inspirados em jogos como sistemas de pontos, conquistas, fases e trilhas de progresso visuais transformam o estudo em uma atividade leve e estimulante, ajudando a manter a consistência a longo prazo do usuário.
                                                 •	Ambiente acolhedor: O ecossistema gamificado oferece um espaço seguro onde o erro não é uma punição, mas uma mecânica de aprendizado. Ao errar um desafio de lógica ou a montagem virtual de um componente, o usuário perde vidas ou recebe dicas imediatas, reduzindo a frustração e o medo comuns em salas de aula tradicionais.
                    "
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtDescrEvolProfissionalCont" />

                <TextView
                    android:id="@+id/txtDescrEvolProfissionalCont"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="A tecnologia, junto ao design educacional e à gamificação, torna o aprendizado mais acessível, interativo e motivador, surgindo como a principal ferramenta para solucionar essas falhas e democratizar o acesso ao ecossistema digital. Essa abordagem atua em três frentes essenciais:   "
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtEvolProfissional" />

                <TextView
                    android:id="@+id/txt4Topico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="4. Conclusão"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txtDescrEvolProfissional" />

                <TextView
                    android:id="@+id/txtDescr4Topico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Romper as barreiras do ensino técnico exige humanizar a tecnologia compreendendo as dificuldades e a melhor forma de aprendizagem, exigindo repensar as ferramentas que utilizamos para ensiná-la. Ao unir a tecnologia educacional e a gamificação à introdução de Software e Hardware, transformamos o aprendizado de uma obrigatoriedade complexa em uma experiência lúdica, receptiva e altamente acessível.) Assim, ao acolher quem está começando do zero, a tecnologia cumpre seu papel mais nobre: o de instrumento de inclusão e transformação social, abrindo as portas do futuro para todos. "
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/cardArtigo"
                    app:layout_constraintTop_toBottomOf="@id/txt4Topico" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnFazerExercicio"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_exercicios"
                android:fontFamily="@font/righteous"
                android:text="Fazer Exercicios"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardArtigo" />

            <View
                android:id="@+id/espaco_nav_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@id/btnFazerExercicio" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:padding="10dp"
    android:background="@drawable/bg_cardconquista_software">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgConquista"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/banner_icon"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conquista"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/azul"
        app:layout_constraintStart_toEndOf="@id/imgConquista"
        app:layout_constraintTop_toTopOf="@id/imgConquista"
        android:layout_marginStart="8dp"/>

    <TextView
        android:id="@+id/txtDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Descrição"
        android:textSize="10sp"
        android:textColor="#353535"
        app:layout_constraintStart_toStartOf="@id/txtTitulo"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
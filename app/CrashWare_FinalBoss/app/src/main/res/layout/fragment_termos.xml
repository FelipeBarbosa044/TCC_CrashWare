<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fundo_claro">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@color/branco"
            android:elevation="10dp"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/addAnotacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:padding="5dp"
                android:background="@drawable/bg_voltar"
                app:layout_constraintTop_toTopOf="@id/header"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Adicionar Anotacao -->
                <ImageView
                    android:id="@+id/imgVoltarCampos"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/seta_icon"
                    app:layout_constraintStart_toStartOf="@id/addAnotacao"
                    app:layout_constraintTop_toTopOf="@id/addAnotacao"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/txtVoltar"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/righteous"
                android:text="Voltar ao perfil"
                android:textColor="@color/azul"
                android:textSize="24sp"
                app:layout_constraintStart_toEndOf="@id/addAnotacao"
                app:layout_constraintTop_toTopOf="@id/addAnotacao" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Titulo Termos de Servico -->
        <TextView
            android:id="@+id/txtTermosServico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/righteous"
            android:text="Termos de Servico"
            android:textAllCaps="true"
            android:textColor="@color/azul"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header" />

        <ImageView
            android:id="@+id/imgTermosServico"
            android:layout_width="345dp"
            android:layout_height="35dp"
            android:layout_marginTop="-16dp"
            android:src="@drawable/termoservico_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTermosServico" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardTermosdeServico"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="15dp"
            android:background="@drawable/bg_card"
            app:layout_constraintTop_toBottomOf="@id/imgTermosServico"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtTermo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="1. Aceitação dos Termos"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toTopOf="@id/cardTermosdeServico" />

            <TextView
                android:id="@+id/txtDescritivoTermo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Ao criar uma conta e utilizar a plataforma CrashWare, você concorda com todos os termos descritos neste documento. Se não concordar com qualquer parte, recomendamos que não utilize nossos serviços."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo1" />

            <TextView
                android:id="@+id/txtTermo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="2. Sobre a Plataforma"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo1" />

            <TextView
                android:id="@+id/txtDescritivoTermo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="A CrashWare é uma plataforma educacional gratuita dedicada ao ensino de hardware e software de forma gamificada e acessível. Nosso objetivo é tornar o aprendizado de tecnologia divertido, progressivo e disponível para todos."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo2" />

            <TextView
                android:id="@+id/txtTermo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="3. Cadastro e Conta"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo2" />

            <TextView
                android:id="@+id/txtDescritivoTermo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Você deve ter no mínimo 13 anos para criar uma conta. As informações fornecidas no cadastro devem ser verídicas e atualizadas. Você é responsável pela segurança da sua senha e por todas as atividades realizadas na sua conta. Em caso de acesso não autorizado, entre em contato conosco imediatamente."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo3" />

            <TextView
                android:id="@+id/txtTermo4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="3. Cadastro e Conta"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo3" />

            <TextView
                android:id="@+id/txtDescritivoTermo4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Você deve ter no mínimo 13 anos para criar uma conta. As informações fornecidas no cadastro devem ser verídicas e atualizadas. Você é responsável pela segurança da sua senha e por todas as atividades realizadas na sua conta. Em caso de acesso não autorizado, entre em contato conosco imediatamente."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo4" />

            <TextView
                android:id="@+id/txtTermo5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="5. Conteúdo Educacional"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo4" />

            <TextView
                android:id="@+id/txtDescritivoTermo5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Todo o conteúdo disponível na CrashWare — lições, trilhas, quizzes, ilustrações e explicações — é de propriedade intelectual da CrashWare. O acesso é gratuito para fins de aprendizado pessoal, mas qualquer uso comercial ou redistribuição é proibido sem autorização"
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo5" />

            <TextView
                android:id="@+id/txtTermo6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="6. Progresso e Gamificação"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo5" />

            <TextView
                android:id="@+id/txtDescritivoTermo6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Seu progresso, pontos, conquistas e streak são vinculados à sua conta. A CrashWare não garante a permanência desses dados em casos de encerramento de conta por violação dos termos ou por decisão do próprio usuário."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo6" />

            <TextView
                android:id="@+id/txtTermo7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="7. Privacidade"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo6" />

            <TextView
                android:id="@+id/txtDescritivoTermo7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Coletamos apenas os dados necessários para o funcionamento da plataforma, como e-mail, progresso nas lições e preferências de uso. Não vendemos seus dados a terceiros. Para mais detalhes, consulte nossa Política de Privacidade."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo7" />

            <TextView
                android:id="@+id/txtTermo8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="8. Disponibilidade do Serviço"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo7" />

            <TextView
                android:id="@+id/txtDescritivoTermo8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="A CrashWare é oferecida de forma gratuita e nos reservamos o direito de realizar manutenções, atualizações ou descontinuar funcionalidades sem aviso prévio. Faremos o possível para comunicar mudanças importantes com antecedência."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo8" />

            <TextView
                android:id="@+id/txtTermo9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="9. Encerramento de Conta"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo8" />

            <TextView
                android:id="@+id/txtDescritivoTermo9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Você pode excluir sua conta a qualquer momento nas configurações. A CrashWare também pode suspender ou encerrar contas que violem estes termos, sem necessidade de aviso prévio."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo9" />

            <TextView
                android:id="@+id/txtTermo10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="10. Alterações nos Termos"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtDescritivoTermo9" />

            <TextView
                android:id="@+id/txtDescritivoTermo10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Estes termos podem ser atualizados periodicamente. Quando isso ocorrer, você será notificado pela plataforma. O uso contínuo após as alterações implica na aceitação dos novos termos."
                android:textColor="@color/azul"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/cardTermosdeServico"
                app:layout_constraintTop_toBottomOf="@id/txtTermo10" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <View
            android:id="@+id/espaco_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardTermosdeServico" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:fillViewport="true"
android:background="@color/fundo_claro">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@color/branco"
        android:elevation="10dp"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/addAnotacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:padding="5dp"
            android:background="@drawable/bg_voltar"
            app:layout_constraintTop_toTopOf="@id/header"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Adicionar Anotacao -->
            <ImageView
                android:id="@+id/imgVoltarCampos"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/seta_icon"
                app:layout_constraintStart_toStartOf="@id/addAnotacao"
                app:layout_constraintTop_toTopOf="@id/addAnotacao"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/txtVoltar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/righteous"
            android:text="Voltar"
            android:textColor="@color/azul"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@id/addAnotacao"
            app:layout_constraintTop_toTopOf="@id/addAnotacao" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Titulo Conquistas -->
    <TextView
        android:id="@+id/txtConquistas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/righteous"
        android:text="Conquistas"
        android:textAllCaps="true"
        android:textColor="@color/azul"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <!-- Decoração do Titulo -->
    <ImageView
        android:id="@+id/imgConquistas"
        android:layout_width="270dp"
        android:layout_height="40dp"
        android:layout_marginTop="-35dp"
        android:src="@drawable/conquistasperfil_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtConquistas" />

    <!-- Card Conquistas Adquiridas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardConquistasAdquiridas"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="15dp"
        android:background="@drawable/bg_cardefeitovidroconquistas"
        app:layout_constraintTop_toBottomOf="@id/imgConquistas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titulo Adquiridas -->
        <TextView
            android:id="@+id/txtConquistasAdquiridas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/righteous"
            android:text="Adquiridas"
            android:textAllCaps="true"
            android:textColor="@color/azul"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/rvConquistas"
            app:layout_constraintEnd_toEndOf="@+id/cardConquistasAdquiridas"
            app:layout_constraintStart_toStartOf="@+id/cardConquistasAdquiridas"
            app:layout_constraintTop_toTopOf="@id/cardConquistasAdquiridas" />

        <!-- Lista das Conquistas Adquiridas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConquistasAdquiridas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/txtConquistasAdquiridas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card Conquistas Bloqueadas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardConquistasBloqueadas"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="15dp"
        android:background="@drawable/bg_cardefeitovidroconquistas"
        app:layout_constraintTop_toBottomOf="@id/cardConquistasAdquiridas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titulo Bloqueadas -->
        <TextView
            android:id="@+id/txtConquistasBloqueadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/righteous"
            android:text="Bloqueadas"
            android:textAllCaps="true"
            android:textColor="@color/azul"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/rvConquistas"
            app:layout_constraintEnd_toEndOf="@+id/cardConquistasBloqueadas"
            app:layout_constraintStart_toStartOf="@+id/cardConquistasBloqueadas"
            app:layout_constraintTop_toTopOf="@id/cardConquistasBloqueadas" />

        <!-- Lista Conquistas Bloqueadas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConquistasBloqueadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/txtConquistasBloqueadas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Nosso espaçamento padrão -->
    <View
        android:id="@+id/espaco_nav_bar"
        android:layout_width="match_parent"
        android:layout_marginTop="2dp"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardConquistasBloqueadas" />
</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>